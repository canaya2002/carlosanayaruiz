# ─────────────────────────────────────────────────────────────────────
# Verificación de Search Console
# Se emiten como <meta> solo si tienen valor — vacías no generan etiqueta.
# Google: Search Console > Añadir propiedad > Etiqueta HTML > copia el content
# Bing:   Bing Webmaster Tools > Verify > Meta tag > copia el content
#
# Bing importa especialmente aquí: es lo que alimenta el grounding de Copilot.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────
# IndexNow (Bing + Copilot). Ver docs/seo/INDEXNOW.md
# La clave también debe servirse como archivo estático en /<clave>.txt
# con la clave misma como contenido.
# ─────────────────────────────────────────────────────────────────────
INDEXNOW_KEY=

# ─────────────────────────────────────────────────────────────────────
# NO HAY VARIABLES DE BACKEND.
#
# El sitio no tiene base de datos. Firebase / Firestore fue eliminado por
# completo: el formulario de contacto abre el cliente de correo del visitante
# con un mailto:, así que no hay credenciales que configurar ni endpoint que
# apuntar.
#
# Si algún día se añade recepción real de formularios (Resend, Formspree, una
# Route Handler propia), su variable va aquí — y el host concreto tiene que
# añadirse a `connect-src` en next.config.ts, nunca con comodín.
# ─────────────────────────────────────────────────────────────────────
