# ════════════════════════════════════════════════════════════════
# Variables de entorno. Copia a `.env.local` y rellena lo que uses.
#
# NADA de esto es obligatorio para que el sitio arranque. Cada cosa degrada
# sola: sin su clave, el canal no se pinta o dice honestamente que no está
# conectado. Nada se rompe y nada finge.
#
# El paso a paso de dónde sale cada valor está en docs/CONECTAR.md.
# ════════════════════════════════════════════════════════════════

# ── 1. Verificación de propiedad en los buscadores ─────────────
# El token que dan Search Console y Bing Webmaster Tools. Sin ellos el sitio
# funciona igual; solo no puedes reclamar la propiedad por meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=


# ── 2. AGENDAR UNA REUNIÓN · Cal.com ───────────────────────────
# Lo que va DESPUÉS de cal.com/ — usuario y evento.
#   https://cal.com/carlosanaya/30min   →   carlosanaya/30min
#
# Sin esto, la fila «ch c · agendar» simplemente no se pinta. Un botón que
# lleva a un 404 es peor que un botón que no está.
#
# Va como enlace y NO como embed a propósito: el embed oficial mete una
# librería, un iframe y un script de terceros que compiten por el hilo
# principal justo donde se mide el LCP. Ver lib/channels.ts.
NEXT_PUBLIC_CAL_LINK=


# ── 3. RECIBIR EL FORMULARIO · Resend ──────────────────────────
# ⚠ EL DOMINIO TIENE QUE ESTAR VERIFICADO EN RESEND (DKIM + SPF por DNS).
#   Sin verificar, la API responde 403 y el formulario dirá que algo falló.
#   Es el único paso que obliga a esperar propagación de DNS.
#
# Sin estas dos, el formulario NO dice «enviado»: dice que la recepción no
# está conectada y ofrece WhatsApp y el correo directo, que no dependen de
# nada. Un formulario que finge en producción es peor que no tenerlo.
RESEND_API_KEY=
# Un remitente del dominio verificado. Puede ser un buzón que no exista.
CONTACT_FROM=
# Opcional: a dónde llegan los mensajes. Por defecto, el correo de NAP.
CONTACT_TO=


# ── 4. EL BOLETÍN ──────────────────────────────────────────────
# Sin SDK a propósito: cualquier proveedor acepta un POST con JSON, así que
# dos variables y un `fetch` hacen el trabajo y se cambia de proveedor sin
# tocar una línea de código. Ver lib/newsletter.ts.
#
#   Resend      https://api.resend.com/audiences/<AUDIENCE_ID>/contacts
#   Buttondown  https://api.buttondown.email/v1/subscribers
#   Brevo       https://api.brevo.com/v3/contacts
NEWSLETTER_ENDPOINT=
# El bearer. Con Resend puede ser la MISMA clave de arriba.
NEWSLETTER_TOKEN=
# El nombre del campo del correo en el cuerpo JSON. Por defecto `email`.
# Resend usa `email`; Buttondown usa `email_address`.
NEWSLETTER_FIELD=


# ── 5. EL BLOG: PUBLICACIÓN PROGRAMADA Y ENVÍO ─────────────────
# Cien artículos ya escritos que salen uno cada martes y cada viernes a las
# 14:00 UTC (08:00 en Ciudad de México), del 25/08/2026 al 06/08/2027.
#
# Las fechas viven en data/blog.ts y son ABSOLUTAS: un artículo aparece
# cuando su fecha llega, no cuando se despliega. El calendario no depende
# de que el sitio esté desplegado un día concreto.
#
# Lo que hace el cron cada martes y viernes (app/api/cron/publicar):
#   1. revalida el artículo, el índice, el sitemap y el feed
#   2. manda ese artículo a la lista por Resend Broadcasts
#
# La IDEMPOTENCIA no necesita base de datos: cada difusión se crea con el
# nombre `blog-{slug}` y antes de crearla se listan las existentes. Si ya
# está, no se manda otra vez. El estado vive en Resend, que es donde está
# la verdad de si un correo salió.

# La audiencia de Resend donde viven los suscriptores.
#   https://resend.com/audiences  →  Create Audience  →  copia el UUID
# Sin esto, el alta al boletín y el envío de artículos no funcionan; el
# formulario lo dice honestamente en vez de fingir que se guardó.
RESEND_AUDIENCE_ID=

# Remitente del boletín. Si está vacío usa CONTACT_FROM. Del dominio
# verificado en Resend, siempre.
NEWSLETTER_FROM=

# ⚠ OBLIGATORIO para que el cron funcione, y por seguridad.
# Vercel lo manda como `Authorization: Bearer $CRON_SECRET`. Sin él la ruta
# responde 401 a TODO EL MUNDO —incluido Vercel— a propósito: una ruta que
# dispara correos a una lista no puede quedar abierta por omisión.
# Genéralo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ── 6. EL PUENTE: reenviar el formulario a OTRO SISTEMA ────────
# Cuando alguien llena el formulario de contacto, además del correo el mensaje
# se manda a un endpoint HTTP tuyo: un CRM, un n8n, una Cloud Function, otro
# proyecto. Todo se configura aquí — no hay que tocar código para cambiar de
# destino, de autenticación ni de nombres de campo.
#
# Corre DESPUÉS del correo y dentro de after(), así que el visitante no espera
# a tu sistema. Y si el correo falla, el puente actúa como segundo canal: si
# entrega, el mensaje llegó y el visitante ve «llegó».
#
# ⚠ DIAGNÓSTICO EN UNA LLAMADA, antes de salir a producción:
#     curl -H "Authorization: Bearer $CRON_SECRET" \
#          https://tudominio.com/api/probar-reenvio
#   Devuelve el status, el cuerpo que se envió y la respuesta literal de tu
#   sistema. Con eso se distingue en un intento un token mal puesto (401) de
#   una URL mal escrita (404) de un campo que falta (422).

# OBLIGATORIA, y con https. Sin ella el puente está apagado y no pasa nada más.
# (Solo en desarrollo se acepta http://localhost para probar en local.)
LEAD_WEBHOOK_URL=

# Cómo autenticar: none | bearer | header | basic | hmac      [por omisión: bearer]
#   bearer → Authorization: Bearer <TOKEN>
#   header → <LEAD_WEBHOOK_HEADER>: <TOKEN>
#   basic  → Authorization: Basic base64(<TOKEN>), con TOKEN = "usuario:clave"
#   hmac   → firma HMAC-SHA256 en hex del cuerpo exacto, en <HMAC_HEADER>
LEAD_WEBHOOK_AUTH=

# El secreto. ⚠ OBLIGATORIO salvo con AUTH=none: si falta, el puente se apaga
# entero en vez de mandar peticiones sin autenticar.
LEAD_WEBHOOK_TOKEN=

# Nombre de la cabecera con AUTH=header.                 [por omisión: x-api-key]
LEAD_WEBHOOK_HEADER=
# Nombre de la cabecera de la firma con AUTH=hmac.      [por omisión: x-signature]
LEAD_WEBHOOK_HMAC_HEADER=

# Formato del cuerpo: json | form                             [por omisión: json]
LEAD_WEBHOOK_FORMAT=
# Método HTTP.                                                [por omisión: POST]
LEAD_WEBHOOK_METHOD=

# Renombrar campos SIN tocar código. JSON de origen->destino:
#   {"nombre":"name","email":"email_address","mensaje":"message"}
# Los que no aparezcan conservan su nombre. Campos que se mandan por omisión:
#   event_id, event, enviado_en, nombre, email, asunto, sitio, mensaje,
# Lista blanca de campos base, separados por coma. Vacía = se mandan todos.
# Es lo ÚNICO que QUITA un campo del cuerpo: FIELDS renombra, no borra. Si el
# receptor valida con un esquema estricto, cada campo que no declare da 422 por
# lead, así que aquí se pone exactamente lo que su contrato nombra.
# Campos disponibles: event_id, event, enviado_en, nombre, email, asunto,
# sitio, mensaje, origen, locale
#   LEAD_WEBHOOK_ONLY=nombre,email,mensaje
LEAD_WEBHOOK_ONLY=

#   origen, locale
LEAD_WEBHOOK_FIELDS=

# Campos fijos que se añaden al cuerpo. JSON:
#   {"source":"portafolio","pipeline_id":"abc123"}
LEAD_WEBHOOK_EXTRA=

# Tiempo máximo por intento, en ms.        [por omisión: 8000 · rango 1000–25000]
LEAD_WEBHOOK_TIMEOUT_MS=
# Intentos. Solo reintenta fallos transitorios: 5xx, 408, 429, red y timeout.
# Un 4xx distinto es un contrato que no cuadra y no se reintenta.
#                                                [por omisión: 3 · rango 1–5]
LEAD_WEBHOOK_RETRIES=


# ── 7. WHATSAPP ────────────────────────────────────────────────
# NO HACE FALTA NADA: el número sale de NAP en lib/constants.ts y el enlace
# se abre con el mensaje ya escrito, distinto en cada página.
# Rellena esto SOLO si el número de negocio es otro.
NEXT_PUBLIC_WHATSAPP=


# ── 8. SUPABASE · opcional, y de verdad opcional ───────────────
# Un formulario de contacto no necesita base de datos: necesita que el correo
# llegue. Esto es una copia de respaldo y un historial, no la vía de entrega —
# y está montado en ese orden: si la fila falla pero el correo salió, el
# mensaje llegó y el visitante ve «llegó».
#
# El SQL de la tabla está en docs/CONECTAR.md.
SUPABASE_URL=
# ⚠ NUNCA con prefijo NEXT_PUBLIC_. Ese prefijo la mandaría al navegador de
#   todo el mundo, y esta llave salta RLS: sería dar lectura y escritura de tu
#   base a cualquiera que abra el inspector.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads


# ── Recordatorio legal ─────────────────────────────────────────
# Si cambias de proveedor o empiezas a guardar algo más, el aviso de
# privacidad se actualiza EN EL MISMO COMMIT. Tiene su sección del boletín
# (finalidad, consentimiento, revocación, encargado) y decir ahí algo que no
# es cierto no es un descuido de copy: es una declaración falsa.
